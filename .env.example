# Clockwork configuration: the template.
#
# Clockwork copies this file into its workspace as .env the first time it starts, and the copy is
# the one that counts: ../clockwork-workspace/.env by default. Edit that copy, never this file.
# This template is versioned and public; the copy holds your pod URL and stays on your machine.
#
# The workspace itself is found without any configuration: it is the folder next to the
# application called clockwork-workspace. To use another one, set BLUEPRINT_WORKSPACE in the
# environment Clockwork is started from. It cannot be set in this file, which lives inside it.

# --- the target environment -------------------------------------------------

# A DEV or TEST pod, for example https://fa-xxxx-dev1-saasfaprod1.fa.ocs.oraclecloud.com/
# Never production: the engine refuses to start against one. Oracle pod hostnames legitimately
# contain "saasfaprod1" even on a DEV pod, so the guard reads the environment token from the first
# hostname label instead of searching for a substring.
ORACLE_BASE_URL=

# --- signing in -------------------------------------------------------------
#
# There is no password here, and nowhere to put one. Each run opens on the sign in page in its own
# browser window; you sign in there, second factor included, and nothing is kept afterwards (D19).
#
# SESSION=saved reuses a session captured once with npm run auth instead, which only runs with the
# browser hidden need, since nobody is there to sign in. The session is saved to
# <workspace>/.auth/storageState.json unless STORAGE_STATE says otherwise. That file holds live
# session cookies: as sensitive as the password itself, and never to be copied anywhere.
# SESSION=saved
# STORAGE_STATE=

# --- how a blocked step behaves ---------------------------------------------

# Assisted mode. On by default: a step that cannot find its element pauses on the failing screen,
# waits for you to do the action, and writes your correction back into the blueprint.
# Set it to false for a run nobody is watching, where a wrong label should simply fail the test.
# ASSIST=false

# Runs are headed by default, because assisted mode needs a window you can act in, and signing in
# needs one too. A hidden run therefore needs SESSION=saved and ASSIST=false with it.
# HEADLESS=true

# How many scenarios run at once. Three to five is realistic for one person supervising. The limit
# is the test data, not the machine: two scenarios creating the same object at the same time
# collide in Oracle, so a parallel batch must be composed of independent scenarios.
# WORKERS=1

# A pause after every step, in milliseconds, so you can follow what the engine does. Zero runs at
# full speed. The local interface sets it for you with "slow down so I can follow".
# WATCH_DELAY_MS=700

# How long the window stays up after the last step, in milliseconds, so the final screen is seen.
# Only when the browser is shown.
# END_HOLD_MS=3000

# --- browser ----------------------------------------------------------------

# Leave both empty: the engine drives your default browser when it is Chromium based (Chrome,
# Edge, Brave, Vivaldi, Opera), otherwise any installed one, and only as a last resort Playwright's
# bundled Chromium. The order is deliberate: on a managed Windows workstation the bundled Chromium
# can fail to start headed ("spawn UNKNOWN") while an installed browser works, and assisted mode
# needs a window. Firefox and Safari cannot be driven installed, so a default browser that is one
# of those is skipped. Each run uses a fresh temporary profile, never yours.
#
# Set one of the two below only to override that choice.
# BROWSER_AUTODETECT=false forces the bundled Chromium.
#
# BROWSER_CHANNEL for a browser Playwright names: msedge, chrome, chrome-beta.
BROWSER_CHANNEL=
# BROWSER_EXECUTABLE for one it does not: Brave, Vivaldi, a portable Chromium. Absolute path,
# forward slashes. Set only one of the two; the executable wins if both are filled in.
# BROWSER_EXECUTABLE=C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe
BROWSER_EXECUTABLE=

# --- optional tuning --------------------------------------------------------

# How long to look for an element before pausing, across every strategy and every frame.
# RESOLVE_TIMEOUT_MS=15000

# List of values timing. Raise these if the type ahead list is slow on your pod.
# LOV_OPTION_TIMEOUT_MS=8000
# LOV_CONFIRM_TIMEOUT_MS=5000
# LOV_TYPE_DELAY_MS=40

# How long to wait, after the opening navigation, before deciding the application is showing its
# sign in page.
# SESSION_CHECK_TIMEOUT_MS=1500

# Production guard. Add a token if your test pod uses an unusual naming convention.
# ALLOWED_ENV_TOKENS=dev,test,uat,stage,stg,qa,sandbox
# Deliberate escape hatch for a hostname the guard does not recognise. Think before setting this.
# ALLOW_UNRECOGNISED_HOST=false

# Where journals, screenshots and reports go. <workspace>/reports by default. Relative to the
# application folder when set.
# REPORTS_DIR=
