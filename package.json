{
  "name": "clockwork",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Simon Kreis <simon@kreisconsulting.ca>",
  "description": "Clockwork: a Playwright test engine for Oracle Fusion Cloud that replays declarative test blueprints, binding every element to the visible label a person reads rather than to a stored selector, and pausing for a human when reality has moved.",
  "keywords": [
    "playwright",
    "oracle-fusion",
    "test-automation"
  ],
  "homepage": "https://github.com/SimonKreis/clockwork#readme",
  "bugs": {
    "url": "https://github.com/SimonKreis/clockwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonKreis/clockwork.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "selftest": "playwright test --config playwright.selftest.config.ts",
    "check": "npm run typecheck && npm run selftest",
    "init": "tsx tools/init-workspace.ts",
    "auth": "tsx tools/capture-session.ts",
    "gui": "tsx tools/gui/server.ts",
    "test": "playwright test",
    "ui": "playwright test --ui",
    "test:one": "playwright test -g",
    "report": "tsx tools/report.ts",
    "evidence": "tsx tools/evidence.ts",
    "convert": "tsx tools/convert-legacy.ts",
    "split": "tsx tools/split-legacy-paste.ts",
    "record": "playwright codegen",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20"
  }
}
